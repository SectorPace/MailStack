[Unit]
Description=MailStack IMAP/POP3/ManageSieve (replaces Dovecot imap/pop3)
Documentation=https://github.com/SectorPace/MailStack
After=network-online.target
Wants=network-online.target
@IMAP_CONDITION_LINE@
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
ExecStart=@BIN_DIR@/mailstack-imap --imap 0.0.0.0:143 --imaps 0.0.0.0:993 --pop3 0.0.0.0:110 --pop3s 0.0.0.0:995 --managesieve 0.0.0.0:4190 --metrics 127.0.0.1:9100@IMAP_CERT_ARGS@ --server-name @MAIL_HOST@ --log info@CONFIG_ARG@
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE=65536

ProtectSystem=strict
ReadWritePaths=/home
ProtectHome=no
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes

[Install]
WantedBy=multi-user.target
