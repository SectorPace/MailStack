[Unit]
Description=MailStack admin console (management API + frontend bundle)
Documentation=https://github.com/SectorPace/MailStack
After=network-online.target mailstackd.service
Wants=network-online.target mailstackd.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=mailstack-admin
Group=mailstack-admin
ExecStart=@BIN_DIR@/mailstack-web --bind 127.0.0.1:@ADMIN_PORT@ --dist @DIST_DIR@ --sample-interval 2 --log info@CONFIG_ARG@
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
LimitNOFILE=16384

ProtectSystem=strict
ReadWritePaths=/var/lib/mailstack -/run/sudo -/var/lib/sudo
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes

[Install]
WantedBy=multi-user.target
