[Unit]
Description=MailStack Webmail (independent web client for mailbox users)
Documentation=https://github.com/SectorPace/MailStack
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
ExecStart=@BIN_DIR@/mailstack-webmail --bind 127.0.0.1:@WEBMAIL_PORT@ --dist @DIST_DIR@ --log info@CONFIG_ARG@
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
LimitNOFILE=16384

ProtectSystem=strict
ReadWritePaths=/home /var/lib/mailstack
ProtectHome=no
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes

[Install]
WantedBy=multi-user.target
