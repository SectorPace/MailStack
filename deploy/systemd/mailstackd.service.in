[Unit]
Description=MailStack daemon (inbound SMTP 25/465/587 + outbound queue + privileged RPC)
Documentation=https://github.com/SectorPace/MailStack
After=network-online.target
Wants=network-online.target
ConditionPathExists=@ETC_DIR@/setup.json
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
ExecStart=@BIN_DIR@/mailstackd --port 25 --port 465 --port 587 --log info@CONFIG_ARG@
RuntimeDirectory=mailstack
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE=65536

ProtectSystem=strict
ReadWritePaths=/etc /home /var /run /root
ProtectHome=no
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes

[Install]
WantedBy=multi-user.target
