{
  "name": "mailstack-admin-console",
  "private": true,
  "version": "0.8.0-beta.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:server": "esbuild backend/server.production.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\"",
    "lint": "tsc --noEmit",
    "build:webmail": "esbuild webmail/server.mjs --bundle --platform=node --format=cjs --outfile=dist/webmail.cjs && node -e \"fs.rmSync('dist/webmail-public', {recursive:true, force:true}); fs.cpSync('webmail/public', 'dist/webmail-public', {recursive:true})\"",
    "build:manifest": "node scripts/generate_manifest.mjs",
    "build:all": "npm run build && npm run build:server && npm run build:webmail && npm run build:manifest",
    "test": "node --test tests/*.test.mjs",
    "test:frontend": "vitest run",
    "test:helper": "python3 scripts/test_actions_unit.py",
    "test:backup": "python3 scripts/test_backup_e2e.py",
    "test:all": "npm run lint && npm test && npm run test:frontend && npm run test:helper && npm run test:backup"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "5.8.3",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  },
  "description": "MailStack full-stack mail server administration console",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SectorPace/MailStack.git"
  },
  "bugs": {
    "url": "https://github.com/SectorPace/MailStack/issues"
  },
  "homepage": "https://github.com/SectorPace/MailStack#readme",
  "engines": {
    "node": ">=20 <25"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
