# MailStack Environment Configuration Template
# Copy this file to .env or configure in systemd service environment

# Administration Web Console Binding
ADMIN_PORT=8787
ADMIN_HOST=127.0.0.1

# Webmail Console Binding
WEBMAIL_PORT=18788
WEBMAIL_HOST=127.0.0.1

# Cookie Security (1 = Secure HTTPS only, 0 = Allow HTTP for local/tunnel)
COOKIE_SECURE=0

# Node Environment
NODE_ENV=production

# Privileged helper RPC timeout in ms (ACME issuance can take 30-90s)
MAILSTACK_HELPER_TIMEOUT_MS=120000

# Optional: Managed AI Diagnostics Key (Zhipu BigModel GLM-4.7-Flash)
# GLM_API_KEY=your_api_key_here
